// Moksh

// Clamp EXR Half Float
__DEVICE__ float clamp_exr(float x) {
  // treat NaN/Inf by mapping to max finite (±65504)
  if (isnan(x)) return 0.0f;
  if (isinf(x)) return (x < 0.0f) ? -65504.0f : 65504.0f;
  // clamp finite range
  return _clampf(x, -65504.0f, 65504.0f);
}
__DEVICE__ float3 clamp_exr(float3 rgb) {
  return make_float3(
    clamp_exr(rgb.x), 
    clamp_exr(rgb.y), 
    clamp_exr(rgb.z)
  );
}

// LogC3 to Linear 
// https://www.arri.com/resource/blob/31918/66f56e6abb6e5b6553929edf9aa7483e/2017-03-alexa-logc-curve-in-vfx-data.pdf
__DEVICE__ float logc3_to_linear(float t) {
  // Constants
  const float a = 5.555556f;
  const float b = 0.052272f;
  const float c = 0.247190f;
  const float d = 0.385537f;
  const float e = 5.367655f;
  const float f = 0.092809f;
  const float ecutf = 0.149658f;

  // Formula
  if (t > ecutf) {
    return (_powf(10, (t - d) / c) - b) / a;
  }
  return (t - f) / e;
}
__DEVICE__ float3 logc3_to_linear(float3 rgb) {
  return make_float3(
    logc3_to_linear(rgb.x), 
    logc3_to_linear(rgb.y), 
    logc3_to_linear(rgb.z)
  );
}

// Arri Wide Gamut 3 to Arri Wide Gamut 4
__DEVICE__ float3 awg3_to_awg4(float3 out) {

  //Compute matrix for desired gamut transform
  float color_mat[3][3] = {
    { 0.8892563132,  0.1288983397, -0.0181545849},
    { 0.0840833493,  1.0093918524, -0.0934752133},
    { 0.0025691934, -0.0615522914,  1.0589833268},
  };

  //Matrix apply to rgb_linear
  float r_d = out.x * color_mat[0][0] + out.y * color_mat [0][1] + out.z * color_mat[0][2];
  float g_d = out.x * color_mat[1][0] + out.y * color_mat [1][1] + out.z * color_mat[1][2];
  float b_d = out.x * color_mat[2][0] + out.y * color_mat [2][1] + out.z * color_mat[2][2];
  
  return make_float3(r_d, g_d, b_d);
}

// Linear to LogC4
__DEVICE__ float linear_to_logc4(float in) {
  // Constants
  const float a = (_powf(2.0f, 18.0f) - 16.0f) / 117.45f;
  const float b = (1023.0f - 95.0f) / 1023.0f;
  const float c = 95.0f / 1023.0f;
  const float s = (7.0f * _logf(2.0f) * _powf(2.0f, 7.0f - 14.0f * c / b)) / (a * b);
  const float t = (_powf(2.0f, 14.0f * (-c / b) + 6.0f) - 64.0f) / a;
  // Formula
  if (in < t) {
    return (in - t) / s;
    } else {
    return (_log2f(a * in + 64.0f) - 6.0f) / 14.0f * b + c;
  }
}
__DEVICE__ float3 linear_to_logc4(float3 rgb) {
  return make_float3(
    linear_to_logc4(rgb.x), 
    linear_to_logc4(rgb.y), 
    linear_to_logc4(rgb.z)
  );
}


__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B) {
  float3 rgb = make_float3(p_R, p_G, p_B);
	rgb = logc3_to_linear(rgb);
	rgb = awg3_to_awg4(rgb);
  rgb = clamp_exr(rgb);
  rgb = linear_to_logc4(rgb);
  return rgb;
}
